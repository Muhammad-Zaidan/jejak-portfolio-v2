# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Connect → Session pooler. Hanya untuk `npm run db` (membuat tabel + contoh isi), tidak dipakai situs.
SUPABASE_DB_URL=

# Situs
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=Nama Anda
NEXT_PUBLIC_CONTACT_EMAIL=halo@example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/username

# Google Cloud → OAuth client (sama dengan yang diisi di Supabase → Auth → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 byte acak, base64. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

TIMEZONE=Asia/Jakarta
